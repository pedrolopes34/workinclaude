DATABASE_URL=postgres://postgres:senha@localhost:5432/queimadas_sp

# Consulta sob demanda (docs/DECISIONS.md secao 6.43) — fine-grained PAT do
# GitHub, so com permissao "Actions: Read and write" neste repositorio,
# usado pra disparar consulta-sob-demanda.yml quando um visitante pede um
# calculo ao vivo. Sem isso a rota POST /api/consultas falha com erro
# generico (nunca quebra o resto do site).
GITHUB_DISPATCH_TOKEN=
